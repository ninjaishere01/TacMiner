{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode zstd gzip

    handle_path /static/* {
        root * /srv/static
        header Cache-Control "public, max-age=3600"
        file_server
    }

    reverse_proxy web:8000

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
