# ===== Django / domain =====
DOMAIN=your-domain.com
ACME_EMAIL=you@example.com
# أي قيمة فيها $ لازم تتحط بين علامتين تنصيص مفردتين: '...'
SECRET_KEY='generate-a-long-random-secret-key'
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_LOG_LEVEL=INFO

# ===== PostgreSQL (service name "db" inside docker-compose) =====
DB_NAME=tacminer_db
DB_USER=tacminer
DB_PASSWORD='change-me'
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ===== Redis / Celery =====
REDIS_URL=redis://redis:6379/0
CELERY_CONCURRENCY=4
CELERY_TASK_ALWAYS_EAGER=False
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

# ===== AdsGram =====
# Block ID من لوحة AdsGram (Reward block). لو فاضي، شرط الإعلان بيتعطّل.
ADSGRAM_BLOCK_ID=
# نفس السر اللي بيتحط في Reward URL عند AdsGram.
ADSGRAM_REWARD_SECRET='change-me-random-secret'
ADSGRAM_SESSION_TTL_SECONDS=600

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
TELEGRAM_TASK_CHANNEL_1=
TELEGRAM_TASK_CHANNEL_2=
TELEGRAM_TASK_CHANNEL_3=
TELEGRAM_TASK_CHANNEL_4=
TELEGRAM_WITHDRAWAL_GROUP_ID=@Tac_mining_withdrawal
WEBAPP_URL=https://your-domain.com
